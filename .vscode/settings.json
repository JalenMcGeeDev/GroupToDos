{
  "files.exclude": {
    "**/node_modules": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true
  },
  "search.exclude": {
    "**/node_modules": true
  },
  "typescript.tsserver.watchOptions": {
    "excludeDirectories": ["**/node_modules"]
  },
  "json.schemas": [
    {
      "fileMatch": ["/node_modules/**/tsconfig*.json"],
      "schema": {}
    }
  ]
}
